# Environment Variables for Smart Contract Deployment
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Your wallet private key (without 0x prefix)
# Export from MetaMask: Account Details > Export Private Key
DEPLOYER_PRIVATE_KEY=

# RPC URLs (optional - defaults provided)
# Get free RPC from: https://www.alchemy.com/ or https://infura.io/

# Ethereum Sepolia Testnet (for testing)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Ethereum Mainnet (for production)
MAINNET_RPC_URL=https://eth.llamarpc.com

# ================================
# DEPLOYMENT INSTRUCTIONS
# ================================
# 1. Get Sepolia ETH from faucet:
#    - https://sepoliafaucet.com/
#    - https://www.alchemy.com/faucets/ethereum-sepolia
#    - https://faucets.chain.link/sepolia
#
# 2. Deploy to Sepolia:
#    npx hardhat run scripts/deploy.js --network sepolia
#
# 3. Update contract address in:
#    src/contracts/notesContract.ts
